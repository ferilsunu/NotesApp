<aside class="app-sidebar">
    <div class="sidebar-top">
        <!-- Logo & Collapse Toggle -->
        <div class="sidebar-brand-row">
            <a href="/" class="app-brand">
                <div class="brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                </div>
                <span class="brand-name">NoteX</span>
            </a>
            <div class="sidebar-brand-actions d-flex align-items-center">
                <button type="button" class="btn-sidebar-collapse d-none d-lg-flex" id="btnSidebarCollapse" title="Collapse sidebar (Ctrl+\)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line><path d="M15 10l-2 2 2 2"></path></svg>
                </button>
                <button type="button" class="btn-sidebar-close d-flex d-lg-none" id="btnSidebarClose" title="Close sidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        </div>

        <!-- User Profile Card -->
        <div class="sidebar-user-card dropdown">
            <a href="#" class="user-card-inner" id="userMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <div class="user-avatar">
                    <span>{{initials user_logged.name}}</span>
                </div>
                <div class="user-info">
                    <span class="user-name">{{user_logged.name}}</span>
                    <span class="user-status">
                        <span class="status-indicator"></span>
                        Workspace
                    </span>
                </div>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="dropdown-chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
            <div class="dropdown-menu user-dropdown-menu" aria-labelledby="userMenuButton">
                <div class="user-dropdown-header">
                    <div class="user-dropdown-avatar">
                        <span>{{initials user_logged.name}}</span>
                    </div>
                    <div class="user-dropdown-meta">
                        <span class="user-dropdown-name">{{user_logged.name}}</span>
                        <span class="user-dropdown-email">{{user_logged.email}}</span>
                    </div>
                </div>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item user-dropdown-item" href="/logout">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2 flex-shrink-0"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span>Sign Out</span>
                </a>
            </div>
        </div>

        <!-- Quick Create Note Button -->
        <div class="sidebar-cta-wrap">
            <a href="/addNote" class="btn-create-note">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>New Note</span>
            </a>
        </div>

        <!-- Navigation Links -->
        <nav class="sidebar-nav">
            <div class="nav-group-label">WORKSPACE</div>
            <ul class="nav-list">
                <li class="nav-item {{#if (eq activeNav 'notes')}}active{{/if}}">
                    <a href="/" class="nav-link">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        <span class="nav-text">All Notes</span>
                        {{#if totalNotes}}
                        <span class="nav-badge">{{totalNotes}}</span>
                        {{/if}}
                    </a>
                </li>
                <li class="nav-item {{#if (eq activeNav 'notebooks')}}active{{/if}}">
                    <a href="/notebooks" class="nav-link">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                        </svg>
                        <span class="nav-text">Notebooks</span>
                        {{#if totalNotebooks}}
                        <span class="nav-badge">{{totalNotebooks}}</span>
                        {{/if}}
                    </a>
                </li>
            </ul>

            <!-- Notebooks Sub-list -->
            {{#if fetched_notebooks.length}}
            <div class="nav-group-label mt-4">NOTEBOOKS</div>
            <ul class="nav-list sub-nav-list">
                {{#each fetched_notebooks}}
                <li class="nav-item">
                    <a href="/notebooks/{{name}}" class="nav-link">
                        <span class="notebook-dot"></span>
                        <span class="nav-text text-truncate">{{name}}</span>
                        {{#if noteCount}}
                        <span class="nav-badge-sub">{{noteCount}}</span>
                        {{/if}}
                    </a>
                </li>
                {{/each}}
            </ul>
            {{/if}}
        </nav>
    </div>

    <div class="sidebar-bottom">
        <ul class="nav-list">
            <li class="nav-item">
                <a href="https://github.com/ferilsunu/NoteX" target="_blank" rel="noopener" class="nav-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="nav-icon">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                    <span class="nav-text">GitHub</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="https://ferilsunu.com" target="_blank" rel="noopener" class="nav-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    <span class="nav-text">Portfolio</span>
                </a>
            </li>
        </ul>
    </div>
</aside>