    <!-- Core JS Dependencies -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>

    <script>
    $(document).ready(function () {
        // 1. Current Date Banner
        const dateElem = document.getElementById('current-date-badge');
        if (dateElem) {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' };
            dateElem.textContent = now.toLocaleDateString('en-US', options);
        }

        // 2. DataTables Initialization
        const baseDtConfig = {
            language: { 
                search: '', 
                searchPlaceholder: "Search within table...",
                paginate: {
                    previous: '&larr; Prev',
                    next: 'Next &rarr;'
                },
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "No entries found",
                zeroRecords: "No matching records found"
            },
            lengthChange: false,
            pageLength: 8,
            ordering: false,
            destroy: true,
            dom: "<'clean-table-header'f>t<'clean-table-footer'ip>"
        };

        if ($('#myTable').length) {
            $('#myTable').DataTable(baseDtConfig);
        }

        if ($('#myNotebookTable').length) {
            $('#myNotebookTable').DataTable($.extend({}, baseDtConfig, {
                language: $.extend({}, baseDtConfig.language, { searchPlaceholder: "Search notebooks..." })
            }));
        }

        // 3. View Switcher (Grid vs Table)
        const btnGridView = $('#btnGridView');
        const btnTableView = $('#btnTableView');
        const gridContainer = $('#notesGridContainer');
        const tableContainer = $('#notesTableContainer');

        const savedView = localStorage.getItem('notes_view_pref') || 'grid';
        if (savedView === 'table') {
            switchToTableView();
        } else {
            switchToGridView();
        }

        btnGridView.on('click', function() {
            switchToGridView();
            localStorage.setItem('notes_view_pref', 'grid');
        });

        btnTableView.on('click', function() {
            switchToTableView();
            localStorage.setItem('notes_view_pref', 'table');
        });

        function switchToGridView() {
            btnGridView.addClass('active');
            btnTableView.removeClass('active');
            gridContainer.removeClass('d-none');
            tableContainer.addClass('d-none');
        }

        function switchToTableView() {
            btnTableView.addClass('active');
            btnGridView.removeClass('active');
            gridContainer.addClass('d-none');
            tableContainer.removeClass('d-none');
        }

        // 4. Live Search & Notebook Chip Filtering
        let activeNotebookFilter = 'all';
        let searchQuery = '';

        const searchInput = $('#noteSearchInput');
        const clearBtn = $('#clearSearchBtn');
        const noteCards = $('.note-card-item');
        const noResultsState = $('#noResultsState');
        const feedbackElem = $('#notesCountFeedback');

        function applyFilter() {
            let visibleCount = 0;
            const q = searchQuery.toLowerCase().trim();

            noteCards.each(function() {
                const item = $(this);
                const title = (item.data('title') || '').toString().toLowerCase();
                const notebook = (item.data('notebook') || '').toString();
                const content = (item.data('content') || '').toString().toLowerCase();

                const matchesNotebook = (activeNotebookFilter === 'all' || notebook === activeNotebookFilter);
                const matchesSearch = !q || title.includes(q) || content.includes(q);

                if (matchesNotebook && matchesSearch) {
                    item.removeClass('d-none');
                    visibleCount++;
                } else {
                    item.addClass('d-none');
                }
            });

            if (feedbackElem.length) {
                feedbackElem.text(visibleCount + (visibleCount === 1 ? ' Note' : ' Notes'));
            }

            if (visibleCount === 0 && noteCards.length > 0) {
                noResultsState.removeClass('d-none');
            } else {
                noResultsState.addClass('d-none');
            }
        }

        if (searchInput.length) {
            searchInput.on('input', function() {
                searchQuery = $(this).val();
                if (searchQuery.length > 0) {
                    clearBtn.removeClass('d-none');
                } else {
                    clearBtn.addClass('d-none');
                }
                applyFilter();
            });

            clearBtn.on('click', function() {
                searchInput.val('');
                searchQuery = '';
                clearBtn.addClass('d-none');
                applyFilter();
            });

            $('#resetFilterBtn').on('click', function() {
                searchInput.val('');
                searchQuery = '';
                clearBtn.addClass('d-none');
                activeNotebookFilter = 'all';
                $('.filter-chip').removeClass('active');
                $('.filter-chip[data-notebook="all"]').addClass('active');
                applyFilter();
            });
        }

        $('.filter-chip').on('click', function() {
            $('.filter-chip').removeClass('active');
            $(this).addClass('active');
            activeNotebookFilter = $(this).data('notebook');
            applyFilter();
        });

        // 5. Entire Table Row & Note Card Click Navigation
        $(document).on('click', '.clickable-row, .note-box[data-href]', function (e) {
            // Ignore if clicked on an anchor, button, input, form, or delete button
            if ($(e.target).closest('a, button, form, input, select, textarea').length) {
                return;
            }
            const href = $(this).data('href');
            if (href) {
                window.location.href = href;
            }
        });

        // 6. Edit Notebook AJAX population
        $('.edit-button').on('click', function () {
            const id = $(this).val();
            $.ajax({
                type: 'POST',
                url: '/getEditInfo',
                data: { new_id: id },
                success: function (data) {
                    $('.editInput').val(data.name);
                    $('.editInputId').val(data._id);
                }
            });
        });

        // 7. Native Modern Rich Text Editor
        const canvas = document.getElementById('richEditorCanvas');
        const hiddenInput = document.getElementById('hiddenNoteContent');
        const editorForm = document.getElementById('noteEditorForm');

        if (canvas && hiddenInput) {
            function syncEditorData() {
                const htmlContent = canvas.innerHTML;
                hiddenInput.value = htmlContent;

                const text = (canvas.innerText || canvas.textContent || '').trim();
                const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
                const chars = text.length;

                $('#wordCountBadge').text(words + (words === 1 ? ' word' : ' words'));
                $('#charCountBadge').text(chars + (chars === 1 ? ' char' : ' chars'));
            }

            canvas.addEventListener('input', syncEditorData);
            canvas.addEventListener('keyup', syncEditorData);
            canvas.addEventListener('paste', function() { setTimeout(syncEditorData, 20); });
            canvas.addEventListener('blur', syncEditorData);

            if (editorForm) {
                editorForm.addEventListener('submit', function (e) {
                    syncEditorData();
                    const trimmedText = (canvas.innerText || '').trim();
                    if (!trimmedText && !hiddenInput.value.trim()) {
                        e.preventDefault();
                        alert('Please enter some content for your note.');
                        canvas.focus();
                        return false;
                    }
                });
            }

            syncEditorData();

            // Toolbar command buttons
            $('.toolbar-btn[data-cmd]').on('click', function (e) {
                e.preventDefault();
                const cmd = $(this).data('cmd');
                document.execCommand(cmd, false, null);
                canvas.focus();
                syncEditorData();
                updateToolbarStates();
            });

            // Format block (Paragraph, Headings, Quote, Code Block)
            $('#formatBlockSelect').on('change', function () {
                const tag = $(this).val();
                if (tag === 'p') {
                    document.execCommand('formatBlock', false, '<p>');
                } else if (tag === 'h1' || tag === 'h2' || tag === 'h3') {
                    document.execCommand('formatBlock', false, '<' + tag + '>');
                } else if (tag === 'blockquote') {
                    document.execCommand('formatBlock', false, '<blockquote>');
                } else if (tag === 'pre') {
                    document.execCommand('formatBlock', false, '<pre>');
                }
                canvas.focus();
                syncEditorData();
            });

            // Insert Link
            $('#btnInsertLink').on('click', function (e) {
                e.preventDefault();
                const url = prompt('Enter URL (e.g. https://example.com):');
                if (url && url.trim()) {
                    let formattedUrl = url.trim();
                    if (!/^https?:\/\//i.test(formattedUrl) && !formattedUrl.startsWith('/') && !formattedUrl.startsWith('#')) {
                        formattedUrl = 'https://' + formattedUrl;
                    }
                    document.execCommand('createLink', false, formattedUrl);
                    canvas.focus();
                    syncEditorData();
                }
            });

            // Insert Inline Code
            $('#btnInsertCode').on('click', function (e) {
                e.preventDefault();
                const selection = window.getSelection();
                if (selection.rangeCount > 0) {
                    const range = selection.getRangeAt(0);
                    const selectedText = range.toString();
                    if (selectedText) {
                        const codeElem = document.createElement('code');
                        codeElem.textContent = selectedText;
                        range.deleteContents();
                        range.insertNode(codeElem);
                    } else {
                        const codeElem = document.createElement('code');
                        codeElem.innerHTML = '&nbsp;';
                        range.insertNode(codeElem);
                        range.selectNodeContents(codeElem);
                        selection.removeAllRanges();
                        selection.addRange(range);
                    }
                    canvas.focus();
                    syncEditorData();
                }
            });

            // Keyboard Tab Support
            canvas.addEventListener('keydown', function (e) {
                if (e.key === 'Tab') {
                    e.preventDefault();
                    document.execCommand('insertHTML', false, '&nbsp;&nbsp;&nbsp;&nbsp;');
                    syncEditorData();
                }
            });

            function updateToolbarStates() {
                $('.toolbar-btn[data-cmd]').each(function () {
                    const cmd = $(this).data('cmd');
                    if (document.queryCommandState(cmd)) {
                        $(this).addClass('active');
                    } else {
                        $(this).removeClass('active');
                    }
                });
            }

            document.addEventListener('selectionchange', function () {
                if (document.activeElement === canvas) {
                    updateToolbarStates();
                }
            });

            // 8. Rich Editor Formatting Panel / Toolbar Toggle (with LocalStorage persistence)
            const notionToolbar = $('#notionToolbar');
            const btnToggleToolbar = $('#btnToggleToolbar');
            const btnCloseToolbar = $('#btnCloseToolbar');

            function setToolbarState(isVisible) {
                if (isVisible) {
                    notionToolbar.removeClass('toolbar-hidden');
                    btnToggleToolbar.addClass('active');
                    localStorage.setItem('notesapp_editor_toolbar_visible', 'true');
                } else {
                    notionToolbar.addClass('toolbar-hidden');
                    btnToggleToolbar.removeClass('active');
                    localStorage.setItem('notesapp_editor_toolbar_visible', 'false');
                }
            }

            function toggleToolbar() {
                const isCurrentlyHidden = notionToolbar.hasClass('toolbar-hidden');
                setToolbarState(isCurrentlyHidden);
            }

            if (notionToolbar.length) {
                const savedToolbarState = localStorage.getItem('notesapp_editor_toolbar_visible');
                if (savedToolbarState === 'false') {
                    setToolbarState(false);
                } else {
                    setToolbarState(true);
                }

                btnToggleToolbar.on('click', function(e) {
                    e.preventDefault();
                    toggleToolbar();
                });

                btnCloseToolbar.on('click', function(e) {
                    e.preventDefault();
                    setToolbarState(false);
                });

                // Keyboard shortcut: Ctrl+Shift+F or Cmd+Shift+F to toggle toolbar
                $(document).on('keydown', function(e) {
                    if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'F' || e.key === 'f')) {
                        e.preventDefault();
                        toggleToolbar();
                    }
                });
            }
        }

        // 9. Sidebar Focus / Fullscreen Mode Toggle (with LocalStorage persistence)
        function setSidebarState(isCollapsed) {
            if (isCollapsed) {
                $('body').addClass('sidebar-collapsed');
                $('.app-layout').addClass('sidebar-collapsed');
                $('#btnSidebarToggle').addClass('active');
                localStorage.setItem('notesapp_sidebar_collapsed', 'true');
            } else {
                $('body').removeClass('sidebar-collapsed');
                $('.app-layout').removeClass('sidebar-collapsed');
                $('#btnSidebarToggle').removeClass('active');
                localStorage.setItem('notesapp_sidebar_collapsed', 'false');
            }
        }

        function toggleSidebar() {
            const isCurrentlyCollapsed = $('body').hasClass('sidebar-collapsed');
            setSidebarState(!isCurrentlyCollapsed);
        }

        // Initialize saved sidebar preference
        const savedSidebarState = localStorage.getItem('notesapp_sidebar_collapsed');
        if (savedSidebarState === 'true') {
            setSidebarState(true);
        }

        $(document).on('click', '#btnSidebarCollapse, #btnSidebarToggle', function(e) {
            e.preventDefault();
            toggleSidebar();
        });

        // Keyboard Shortcut: Ctrl+\ or Cmd+\ to toggle sidebar
        $(document).on('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === '\\') {
                e.preventDefault();
                toggleSidebar();
            }
        });

        // 10. Notion Full-Width Canvas Mode Toggle (with LocalStorage persistence)
        const docSurface = $('#notionDocSurface');
        const btnFullWidth = $('#btnToggleFullWidth');

        function setFullWidthState(isFullWidth) {
            if (isFullWidth) {
                docSurface.addClass('notion-full-width');
                btnFullWidth.addClass('active');
                localStorage.setItem('notesapp_full_width', 'true');
            } else {
                docSurface.removeClass('notion-full-width');
                btnFullWidth.removeClass('active');
                localStorage.setItem('notesapp_full_width', 'false');
            }
        }

        if (docSurface.length && btnFullWidth.length) {
            const savedFullWidthState = localStorage.getItem('notesapp_full_width');
            if (savedFullWidthState === 'true') {
                setFullWidthState(true);
            }

            btnFullWidth.on('click', function(e) {
                e.preventDefault();
                const isCurrentlyFull = docSurface.hasClass('notion-full-width');
                setFullWidthState(!isCurrentlyFull);
            });
        }
    });
    </script>
    <script src="/js/custom-script.js"></script>
  </body>
</html>