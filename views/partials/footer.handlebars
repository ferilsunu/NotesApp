    <!-- Core JS Dependencies -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>

    <script>
    $(document).ready(function () {
        // 1. Current Date Banner
        const dateElem = document.getElementById('current-date-badge');
        if (dateElem) {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' };
            dateElem.textContent = now.toLocaleDateString('en-US', options);
        }

        // 2. DataTables Initialization
        const baseDtConfig = {
            language: { 
                search: '', 
                searchPlaceholder: "Search within table...",
                paginate: {
                    previous: '&larr; Prev',
                    next: 'Next &rarr;'
                },
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "No entries found",
                zeroRecords: "No matching records found"
            },
            lengthChange: false,
            pageLength: 8,
            ordering: false,
            destroy: true,
            dom: "<'clean-table-header'f>t<'clean-table-footer'ip>"
        };

        if ($('#myTable').length) {
            $('#myTable').DataTable(baseDtConfig);
        }

        if ($('#myNotebookTable').length) {
            $('#myNotebookTable').DataTable($.extend({}, baseDtConfig, {
                language: $.extend({}, baseDtConfig.language, { searchPlaceholder: "Search notebooks..." })
            }));
        }

        // 3. View Switcher (Grid vs Table)
        const btnGridView = $('#btnGridView');
        const btnTableView = $('#btnTableView');
        const gridContainer = $('#notesGridContainer');
        const tableContainer = $('#notesTableContainer');

        const savedView = localStorage.getItem('notes_view_pref') || 'grid';
        if (savedView === 'table') {
            switchToTableView();
        } else {
            switchToGridView();
        }

        btnGridView.on('click', function() {
            switchToGridView();
            localStorage.setItem('notes_view_pref', 'grid');
        });

        btnTableView.on('click', function() {
            switchToTableView();
            localStorage.setItem('notes_view_pref', 'table');
        });

        function switchToGridView() {
            btnGridView.addClass('active');
            btnTableView.removeClass('active');
            gridContainer.removeClass('d-none');
            tableContainer.addClass('d-none');
        }

        function switchToTableView() {
            btnTableView.addClass('active');
            btnGridView.removeClass('active');
            gridContainer.addClass('d-none');
            tableContainer.removeClass('d-none');
        }

        // 4. Live Search & Notebook Chip Filtering
        let activeNotebookFilter = 'all';
        let searchQuery = '';

        const searchInput = $('#noteSearchInput');
        const clearBtn = $('#clearSearchBtn');
        const noteCards = $('.note-card-item');
        const noResultsState = $('#noResultsState');
        const feedbackElem = $('#notesCountFeedback');

        function applyFilter() {
            let visibleCount = 0;
            const q = searchQuery.toLowerCase().trim();

            noteCards.each(function() {
                const item = $(this);
                const title = (item.data('title') || '').toString().toLowerCase();
                const notebook = (item.data('notebook') || '').toString();
                const content = (item.data('content') || '').toString().toLowerCase();

                const matchesNotebook = (activeNotebookFilter === 'all' || notebook === activeNotebookFilter);
                const matchesSearch = !q || title.includes(q) || content.includes(q);

                if (matchesNotebook && matchesSearch) {
                    item.removeClass('d-none');
                    visibleCount++;
                } else {
                    item.addClass('d-none');
                }
            });

            if (feedbackElem.length) {
                feedbackElem.text(visibleCount + (visibleCount === 1 ? ' Note' : ' Notes'));
            }

            if (visibleCount === 0 && noteCards.length > 0) {
                noResultsState.removeClass('d-none');
            } else {
                noResultsState.addClass('d-none');
            }
        }

        if (searchInput.length) {
            searchInput.on('input', function() {
                searchQuery = $(this).val();
                if (searchQuery.length > 0) {
                    clearBtn.removeClass('d-none');
                } else {
                    clearBtn.addClass('d-none');
                }
                applyFilter();
            });

            clearBtn.on('click', function() {
                searchInput.val('');
                searchQuery = '';
                clearBtn.addClass('d-none');
                applyFilter();
            });

            $('#resetFilterBtn').on('click', function() {
                searchInput.val('');
                searchQuery = '';
                clearBtn.addClass('d-none');
                activeNotebookFilter = 'all';
                $('.filter-chip, .filter-chip-pill').removeClass('active');
                $('.filter-chip[data-notebook="all"], .filter-chip-pill[data-notebook="all"]').addClass('active');
                $('#activeFilterLabel').text('All Notes');
                applyFilter();
            });
        }

        // Handle Notebook Filter Selection in Notes View
        $(document).on('click', '.filter-chip, .filter-chip-pill', function() {
            const selectedNotebook = $(this).data('notebook');
            if (!selectedNotebook) return;

            activeNotebookFilter = selectedNotebook;

            // Sync active state on both dropdown items and pill buttons
            $('.filter-chip, .filter-chip-pill').removeClass('active');
            $('.filter-chip[data-notebook="' + selectedNotebook + '"], .filter-chip-pill[data-notebook="' + selectedNotebook + '"]').addClass('active');

            // Update dropdown button label and badge
            const labelText = selectedNotebook === 'all' ? 'All Notes' : selectedNotebook;
            const countText = $(this).find('.item-count, .chip-count').first().text() || '';
            $('#activeFilterLabel').text(labelText);
            if (countText) {
                $('#activeFilterCount').text(countText);
            }

            applyFilter();
        });

        // Handle Custom Notebook Dropdown in Note Editor View
        $(document).on('click', '.notebook-select-option', function(e) {
            e.preventDefault();
            const val = $(this).data('value');
            if (val) {
                const hiddenNotebookInput = document.getElementById('slct');
                if (hiddenNotebookInput) {
                    hiddenNotebookInput.value = val;
                }
                $('#selectedNotebookLabel').text(val);
                $('.notebook-select-option').removeClass('active');
                $(this).addClass('active');

                if (typeof triggerDebouncedSave === 'function' && typeof performAutoSave === 'function') {
                    triggerDebouncedSave();
                    performAutoSave();
                }
            }
        });

        // 5. Entire Table Row & Note Card Click Navigation
        $(document).on('click', '.clickable-row, .note-box[data-href]', function (e) {
            // Ignore if clicked on an anchor, button, input, form, or delete button
            if ($(e.target).closest('a, button, form, input, select, textarea').length) {
                return;
            }
            const href = $(this).data('href');
            if (href) {
                window.location.href = href;
            }
        });

        // 6. Edit Notebook AJAX population
        $('.edit-button').on('click', function () {
            const id = $(this).val();
            $.ajax({
                type: 'POST',
                url: '/getEditInfo',
                data: { new_id: id },
                success: function (data) {
                    $('.editInput').val(data.name);
                    $('.editInputId').val(data._id);
                }
            });
        });

        // 7. Native Modern Rich Text Editor & Notion-like Auto-Save Engine
        const canvas = document.getElementById('richEditorCanvas');
        const hiddenInput = document.getElementById('hiddenNoteContent');
        const titleInput = document.querySelector('textarea[name="title"], input[name="title"]');
        const notebookSelect = document.getElementById('slct');
        const editorForm = document.getElementById('noteEditorForm');
        const autoSaveStatus = document.getElementById('autoSaveStatus');

        if (canvas && editorForm) {
            let noteMode = editorForm.getAttribute('data-mode') || 'edit';
            let currentNoteId = editorForm.getAttribute('data-note-id') || '';
            let saveTimer = null;
            let isSaving = false;
            let saveQueued = false;

            // Auto-resize title textarea dynamically
            function autoResizeTitle(el) {
                if (!el) return;
                el.style.height = 'auto';
                el.style.height = (el.scrollHeight || 48) + 'px';
            }

            if (titleInput) {
                autoResizeTitle(titleInput);
                window.addEventListener('resize', function() {
                    autoResizeTitle(titleInput);
                });
            }

            // Initial saved state baseline to avoid redundant DB writes
            let lastSavedState = {
                title: (titleInput ? titleInput.value : '').trim(),
                note: (canvas.innerHTML || '').trim(),
                notebook: (notebookSelect ? notebookSelect.value : '').trim()
            };

            function updateCounters() {
                const text = (canvas.innerText || canvas.textContent || '').trim();
                const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
                const chars = text.length;

                $('#wordCountBadge').text(words + (words === 1 ? ' word' : ' words'));
                $('#charCountBadge').text(chars + (chars === 1 ? ' char' : ' chars'));
                if (hiddenInput) {
                    hiddenInput.value = canvas.innerHTML;
                }
            }

            function setSaveStatus(state, message) {
                if (!autoSaveStatus) return;
                const iconSaved = autoSaveStatus.querySelector('.icon-saved');
                const iconSaving = autoSaveStatus.querySelector('.icon-saving');
                const textEl = autoSaveStatus.querySelector('.save-status-text');

                autoSaveStatus.classList.remove('status-saving', 'status-saved', 'status-error', 'status-unsaved');

                if (state === 'saving') {
                    autoSaveStatus.classList.add('status-saving');
                    if (iconSaved) iconSaved.classList.add('d-none');
                    if (iconSaving) iconSaving.classList.remove('d-none');
                    if (textEl) textEl.textContent = 'Saving...';
                } else if (state === 'saved') {
                    autoSaveStatus.classList.add('status-saved');
                    if (iconSaved) iconSaved.classList.remove('d-none');
                    if (iconSaving) iconSaving.classList.add('d-none');
                    if (textEl) textEl.textContent = message || 'Saved';
                } else if (state === 'unsaved') {
                    autoSaveStatus.classList.add('status-unsaved');
                    if (iconSaved) iconSaved.classList.add('d-none');
                    if (iconSaving) iconSaving.classList.add('d-none');
                    if (textEl) textEl.textContent = 'Unsaved changes';
                } else if (state === 'error') {
                    autoSaveStatus.classList.add('status-error');
                    if (iconSaved) iconSaved.classList.add('d-none');
                    if (iconSaving) iconSaving.classList.add('d-none');
                    if (textEl) textEl.textContent = 'Failed to save (Retry)';
                }
            }

            function isDirty() {
                const currentTitle = (titleInput ? titleInput.value : '').trim();
                const currentNote = (canvas.innerHTML || '').trim();
                const currentNotebook = (notebookSelect ? notebookSelect.value : '').trim();

                return currentTitle !== lastSavedState.title ||
                       currentNote !== lastSavedState.note ||
                       currentNotebook !== lastSavedState.notebook;
            }

            async function performAutoSave() {
                if (!isDirty()) {
                    setSaveStatus('saved');
                    return;
                }

                if (isSaving) {
                    saveQueued = true;
                    return;
                }

                const currentTitle = (titleInput ? titleInput.value : '').trim() || 'Untitled';
                const currentNote = canvas.innerHTML;
                const currentNotebook = (notebookSelect ? notebookSelect.value : '').trim() || 'General';

                // Don't auto-create note if empty in add mode
                if (noteMode === 'add' && !currentNote.trim() && (!titleInput || !titleInput.value.trim())) {
                    return;
                }

                isSaving = true;
                setSaveStatus('saving');

                try {
                    let url = '';
                    let method = 'POST';

                    if (noteMode === 'add' && !currentNoteId) {
                        url = '/addNote';
                        method = 'POST';
                    } else {
                        url = '/editNote/' + currentNoteId;
                        method = 'POST';
                    }

                    const response = await fetch(url, {
                        method: method,
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            title: currentTitle,
                            note: currentNote,
                            notebook: currentNotebook
                        })
                    });

                    const data = await response.json();

                    if (data && data.success) {
                        lastSavedState = {
                            title: currentTitle === 'Untitled' && (!titleInput || !titleInput.value.trim()) ? '' : currentTitle,
                            note: currentNote.trim(),
                            notebook: currentNotebook
                        };

                        if (noteMode === 'add' && data.noteId) {
                            currentNoteId = data.noteId;
                            noteMode = 'edit';
                            editorForm.setAttribute('data-mode', 'edit');
                            editorForm.setAttribute('data-note-id', currentNoteId);
                            editorForm.action = '/editNote/' + currentNoteId + '?_method=PUT';
                            window.history.replaceState(null, '', '/SingleNote/' + currentNoteId);
                        }

                        setSaveStatus('saved');
                    } else {
                        setSaveStatus('error');
                    }
                } catch (err) {
                    console.error('AutoSave Error:', err);
                    setSaveStatus('error');
                } finally {
                    isSaving = false;
                    if (saveQueued) {
                        saveQueued = false;
                        if (isDirty()) {
                            performAutoSave();
                        }
                    }
                }
            }

            function triggerDebouncedSave() {
                updateCounters();
                if (isDirty()) {
                    setSaveStatus('unsaved');
                    clearTimeout(saveTimer);
                    saveTimer = setTimeout(performAutoSave, 800);
                } else {
                    setSaveStatus('saved');
                }
            }

            // Clean & sanitize pasted content (e.g. from ChatGPT, Notion, Word, or Web)
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function insertHtmlAtCursor(html) {
                canvas.focus();
                const sel = window.getSelection();
                if (!sel || sel.rangeCount === 0) {
                    document.execCommand('insertHTML', false, html);
                    return;
                }

                let range = sel.getRangeAt(0);
                if (!canvas.contains(range.commonAncestorContainer)) {
                    canvas.focus();
                    range = document.createRange();
                    range.selectNodeContents(canvas);
                    range.collapse(false);
                    sel.removeAllRanges();
                    sel.addRange(range);
                }

                try {
                    range.deleteContents();
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = html;
                    const frag = document.createDocumentFragment();
                    let node, lastNode;
                    while ((node = tempDiv.firstChild)) {
                        lastNode = frag.appendChild(node);
                    }
                    range.insertNode(frag);

                    if (lastNode) {
                        const newRange = range.cloneRange();
                        newRange.setStartAfter(lastNode);
                        newRange.collapse(true);
                        sel.removeAllRanges();
                        sel.addRange(newRange);
                    }
                } catch (e) {
                    document.execCommand('insertHTML', false, html);
                }
            }

            // Bulletproof Paste Interception on rich canvas
            canvas.addEventListener('paste', function (e) {
                e.preventDefault();
                const clipboardData = e.clipboardData || window.clipboardData;
                if (!clipboardData) return;

                const pastedHtml = clipboardData.getData('text/html');
                const pastedText = clipboardData.getData('text/plain') || '';

                let htmlToInsert = '';

                if (pastedHtml && pastedHtml.trim()) {
                    try {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(pastedHtml, 'text/html');

                        // Remove scripts, styles, metadata
                        doc.querySelectorAll('style, script, meta, link, title, head, svg, path, iframe, object, embed').forEach(function(el) {
                            el.remove();
                        });

                        // Clean attributes
                        doc.body.querySelectorAll('*').forEach(function(el) {
                            const href = el.tagName.toLowerCase() === 'a' ? el.getAttribute('href') : null;
                            el.removeAttribute('style');
                            el.removeAttribute('class');
                            el.removeAttribute('id');
                            if (href) {
                                el.setAttribute('href', href);
                                el.setAttribute('target', '_blank');
                                el.setAttribute('rel', 'noopener noreferrer');
                            }
                        });

                        const cleaned = (doc.body.innerHTML || '').trim();
                        if (cleaned) {
                            htmlToInsert = cleaned;
                        }
                    } catch (err) {
                        console.warn('HTML Paste Sanitizer fallback:', err);
                        htmlToInsert = '';
                    }
                }

                // Fallback to plain text if HTML was empty or failed
                if (!htmlToInsert && pastedText) {
                    const lines = pastedText.split(/\r\n|\r|\n/);
                    if (lines.length <= 1) {
                        htmlToInsert = escapeHtml(pastedText);
                    } else {
                        htmlToInsert = lines.map(function(line) {
                            const trimmed = line.trim();
                            return trimmed ? '<p>' + escapeHtml(line) + '</p>' : '<p><br></p>';
                        }).join('');
                    }
                }

                if (htmlToInsert) {
                    insertHtmlAtCursor(htmlToInsert);
                }

                setTimeout(function() {
                    updateCounters();
                    triggerDebouncedSave();
                }, 20);
            });

            // Bind input and formatting triggers
            canvas.addEventListener('input', triggerDebouncedSave);
            canvas.addEventListener('keyup', triggerDebouncedSave);
            canvas.addEventListener('blur', function() {
                updateCounters();
                if (isDirty()) {
                    clearTimeout(saveTimer);
                    performAutoSave();
                }
            });

            if (titleInput) {
                titleInput.addEventListener('input', function() {
                    autoResizeTitle(this);
                    triggerDebouncedSave();
                });
                titleInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        if (canvas) {
                            canvas.focus();
                        }
                    }
                });
                titleInput.addEventListener('blur', function() {
                    autoResizeTitle(this);
                    if (isDirty()) {
                        clearTimeout(saveTimer);
                        performAutoSave();
                    }
                });
            }

            if (notebookSelect) {
                notebookSelect.addEventListener('change', function() {
                    triggerDebouncedSave();
                    performAutoSave(); // instant save on notebook select
                });
            }

            // Retry saving on clicking status badge if errored
            if (autoSaveStatus) {
                autoSaveStatus.addEventListener('click', function() {
                    if (isDirty() || autoSaveStatus.classList.contains('status-error')) {
                        clearTimeout(saveTimer);
                        performAutoSave();
                    }
                });
            }

            // Save immediately if leaving or reloading page
            window.addEventListener('beforeunload', function() {
                if (isDirty() && currentNoteId) {
                    const currentTitle = (titleInput ? titleInput.value : '').trim() || 'Untitled';
                    const payload = JSON.stringify({
                        title: currentTitle,
                        note: canvas.innerHTML,
                        notebook: (notebookSelect ? notebookSelect.value : '').trim() || 'General'
                    });
                    const blob = new Blob([payload], { type: 'application/json' });
                    navigator.sendBeacon('/editNote/' + currentNoteId, blob);
                }
            });

            updateCounters();
            setSaveStatus('saved');

            // Toolbar command buttons
            $('.toolbar-btn[data-cmd]').on('click', function (e) {
                e.preventDefault();
                const cmd = $(this).data('cmd');
                document.execCommand(cmd, false, null);
                canvas.focus();
                triggerDebouncedSave();
                updateToolbarStates();
            });

            // Format block (Paragraph, Headings, Quote, Code Block)
            $('#formatBlockSelect').on('change', function () {
                const tag = $(this).val();
                if (tag === 'p') {
                    document.execCommand('formatBlock', false, '<p>');
                } else if (tag === 'h1' || tag === 'h2' || tag === 'h3') {
                    document.execCommand('formatBlock', false, '<' + tag + '>');
                } else if (tag === 'blockquote') {
                    document.execCommand('formatBlock', false, '<blockquote>');
                } else if (tag === 'pre') {
                    document.execCommand('formatBlock', false, '<pre>');
                }
                canvas.focus();
                triggerDebouncedSave();
            });

            // Font size select
            $('#fontSizeSelect').on('change', function () {
                const size = $(this).val();
                if (size) {
                    document.execCommand('fontSize', false, size);
                    canvas.focus();
                    triggerDebouncedSave();
                }
            });

            // Insert Link
            $('#btnInsertLink').on('click', function (e) {
                e.preventDefault();
                const url = prompt('Enter URL (e.g. https://example.com):');
                if (url && url.trim()) {
                    let formattedUrl = url.trim();
                    if (!/^https?:\/\//i.test(formattedUrl) && !formattedUrl.startsWith('/') && !formattedUrl.startsWith('#')) {
                        formattedUrl = 'https://' + formattedUrl;
                    }
                    document.execCommand('createLink', false, formattedUrl);
                    canvas.focus();
                    triggerDebouncedSave();
                }
            });

            // Insert Inline Code
            $('#btnInsertCode').on('click', function (e) {
                e.preventDefault();
                const selection = window.getSelection();
                if (selection.rangeCount > 0) {
                    const range = selection.getRangeAt(0);
                    const selectedText = range.toString();
                    if (selectedText) {
                        const codeElem = document.createElement('code');
                        codeElem.textContent = selectedText;
                        range.deleteContents();
                        range.insertNode(codeElem);
                    } else {
                        const codeElem = document.createElement('code');
                        codeElem.innerHTML = '&nbsp;';
                        range.insertNode(codeElem);
                        range.selectNodeContents(codeElem);
                        selection.removeAllRanges();
                        selection.addRange(range);
                    }
                    canvas.focus();
                    triggerDebouncedSave();
                }
            });

            // Keyboard Tab Support
            canvas.addEventListener('keydown', function (e) {
                if (e.key === 'Tab') {
                    e.preventDefault();
                    document.execCommand('insertHTML', false, '&nbsp;&nbsp;&nbsp;&nbsp;');
                    triggerDebouncedSave();
                }
            });

            function updateToolbarStates() {
                $('.toolbar-btn[data-cmd]').each(function () {
                    const cmd = $(this).data('cmd');
                    if (document.queryCommandState(cmd)) {
                        $(this).addClass('active');
                    } else {
                        $(this).removeClass('active');
                    }
                });
            }

            document.addEventListener('selectionchange', function () {
                if (document.activeElement === canvas) {
                    updateToolbarStates();
                }
            });

            // 8. Rich Editor Formatting Panel / Toolbar Toggle (with LocalStorage persistence)
            const notionToolbar = $('#notionToolbar');
            const btnToggleToolbar = $('#btnToggleToolbar');
            const btnCloseToolbar = $('#btnCloseToolbar');

            function setToolbarState(isVisible) {
                if (isVisible) {
                    notionToolbar.removeClass('toolbar-hidden');
                    btnToggleToolbar.addClass('active');
                    localStorage.setItem('notesapp_editor_toolbar_visible', 'true');
                } else {
                    notionToolbar.addClass('toolbar-hidden');
                    btnToggleToolbar.removeClass('active');
                    localStorage.setItem('notesapp_editor_toolbar_visible', 'false');
                }
            }

            function toggleToolbar() {
                const isCurrentlyHidden = notionToolbar.hasClass('toolbar-hidden');
                setToolbarState(isCurrentlyHidden);
            }

            if (notionToolbar.length) {
                const savedToolbarState = localStorage.getItem('notesapp_editor_toolbar_visible');
                if (savedToolbarState === 'false') {
                    setToolbarState(false);
                } else {
                    setToolbarState(true);
                }

                btnToggleToolbar.on('click', function(e) {
                    e.preventDefault();
                    toggleToolbar();
                });

                btnCloseToolbar.on('click', function(e) {
                    e.preventDefault();
                    setToolbarState(false);
                });

                // Keyboard shortcut: Ctrl+Shift+F or Cmd+Shift+F to toggle toolbar
                $(document).on('keydown', function(e) {
                    if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'F' || e.key === 'f')) {
                        e.preventDefault();
                        toggleToolbar();
                    }
                });
            }
        }

        // 9. Sidebar Focus / Fullscreen Mode Toggle (with LocalStorage persistence)
        function setSidebarState(isCollapsed) {
            if (isCollapsed) {
                $('body').addClass('sidebar-collapsed');
                $('.app-layout').addClass('sidebar-collapsed');
                $('#btnSidebarToggle').addClass('active');
                localStorage.setItem('notesapp_sidebar_collapsed', 'true');
            } else {
                $('body').removeClass('sidebar-collapsed');
                $('.app-layout').removeClass('sidebar-collapsed');
                $('#btnSidebarToggle').removeClass('active');
                localStorage.setItem('notesapp_sidebar_collapsed', 'false');
            }
        }

        function toggleSidebar() {
            const isCurrentlyCollapsed = $('body').hasClass('sidebar-collapsed');
            setSidebarState(!isCurrentlyCollapsed);
        }

        // Initialize saved sidebar preference
        const savedSidebarState = localStorage.getItem('notesapp_sidebar_collapsed');
        if (savedSidebarState === 'true') {
            setSidebarState(true);
        }

        $(document).on('click', '#btnSidebarCollapse, #btnSidebarToggle', function(e) {
            e.preventDefault();
            toggleSidebar();
        });

        // Keyboard Shortcut: Ctrl+\ or Cmd+\ to toggle sidebar
        $(document).on('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === '\\') {
                e.preventDefault();
                toggleSidebar();
            }
        });

        // 10. Notion Full-Width Canvas Mode Toggle (with LocalStorage persistence)
        const docSurface = $('#notionDocSurface');
        const btnFullWidth = $('#btnToggleFullWidth');

        function setFullWidthState(isFullWidth) {
            if (isFullWidth) {
                docSurface.addClass('notion-full-width');
                btnFullWidth.addClass('active');
                localStorage.setItem('notesapp_full_width', 'true');
            } else {
                docSurface.removeClass('notion-full-width');
                btnFullWidth.removeClass('active');
                localStorage.setItem('notesapp_full_width', 'false');
            }
        }

        if (docSurface.length && btnFullWidth.length) {
            const savedFullWidthState = localStorage.getItem('notesapp_full_width');
            if (savedFullWidthState === 'true') {
                setFullWidthState(true);
            }

            btnFullWidth.on('click', function(e) {
                e.preventDefault();
                const isCurrentlyFull = docSurface.hasClass('notion-full-width');
                setFullWidthState(!isCurrentlyFull);
            });
        }
    });
    </script>
    <script src="/js/custom-script.js"></script>
  </body>
</html>