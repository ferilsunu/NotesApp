<div class="content-page">
    <div class="container-fluid">
        <!-- Flash Alerts -->
        {{#if success_message}}
        <div class="alert alert-custom alert-success d-flex align-items-center mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-3 flex-shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <div>{{success_message}}</div>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        {{/if}}

        {{#if error}}
        <div class="alert alert-custom alert-danger d-flex align-items-center mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-3 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <div>{{error}}</div>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        {{/if}}

        <!-- Hero Header -->
        <div class="hero-header-card mb-4">
            <div class="row align-items-center">
                <div class="col-lg-7 col-12 mb-3 mb-lg-0">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge-status-pill">
                            <span class="status-dot"></span>
                            Workspace Active
                        </span>
                        <span class="text-muted font-size-13 ml-3 d-none d-sm-inline" id="current-date-badge"></span>
                    </div>
                    <h2 class="hero-title mb-1">Welcome back, {{user_logged.name}}</h2>
                    <p class="hero-subtitle mb-0">Capture ideas, project specs, and organize your knowledge effortlessly.</p>
                </div>
                <div class="col-lg-5 col-12 text-lg-right d-flex align-items-center justify-content-lg-end gap-3 flex-wrap">
                    <div class="stat-pill">
                        <span class="stat-pill-count">{{totalNotes}}</span>
                        <span class="stat-pill-label">Notes</span>
                    </div>
                    <div class="stat-pill">
                        <span class="stat-pill-count">{{totalNotebooks}}</span>
                        <span class="stat-pill-label">Notebooks</span>
                    </div>
                    <a href="/addNote" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>New Note</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter & View Controls -->
        <div class="controls-card mb-4">
            <div class="row align-items-center justify-content-between">
                <!-- Search & Filters -->
                <div class="col-md-7 col-12 mb-3 mb-md-0">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <div class="search-input-wrap">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <input type="text" id="noteSearchInput" class="search-input-field" placeholder="Search notes by title or content...">
                            <button type="button" id="clearSearchBtn" class="clear-search-btn d-none" title="Clear search">&times;</button>
                        </div>
                    </div>
                </div>

                <!-- View Switcher -->
                <div class="col-md-5 col-12 text-md-right d-flex align-items-center justify-content-md-end justify-content-between">
                    <span class="font-size-13 text-muted mr-3 d-none d-sm-inline" id="notesCountFeedback">{{totalNotes}} Notes</span>
                    <div class="view-switcher-group">
                        <button type="button" class="view-switch-btn active" id="btnGridView" title="Grid View">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                            <span class="d-none d-sm-inline ml-1">Grid</span>
                        </button>
                        <button type="button" class="view-switch-btn" id="btnTableView" title="Table View">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                            <span class="d-none d-sm-inline ml-1">Table</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Notebook Quick Chips -->
            {{#if fetched_notebooks.length}}
            <div class="notebook-chips-wrap mt-3 pt-3 border-top">
                <span class="chip-label mr-2">Filter by:</span>
                <button type="button" class="filter-chip active" data-notebook="all">
                    All Notes <span class="chip-count">{{totalNotes}}</span>
                </button>
                {{#each fetched_notebooks}}
                <button type="button" class="filter-chip" data-notebook="{{name}}">
                    {{name}} <span class="chip-count">{{noteCount}}</span>
                </button>
                {{/each}}
            </div>
            {{/if}}
        </div>

        <!-- 1. GRID VIEW CONTAINER -->
        <div id="notesGridContainer">
            {{#if fetched_notes.length}}
            <div class="row" id="notesCardGrid">
                {{#each fetched_notes}}
                <div class="col-xl-4 col-lg-6 col-md-6 col-12 mb-4 note-card-item" data-title="{{title}}" data-notebook="{{notebook}}" data-content="{{stripTags note}}">
                    <div class="note-card h-100 d-flex flex-column">
                        <div class="note-card-header d-flex align-items-center justify-content-between mb-2">
                            <span class="notebook-pill" data-notebook="{{notebook}}">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                {{notebook}}
                            </span>
                            <span class="note-time-badge" title="{{GenerateDate date 'DD MMMM YYYY, hh:mm A'}}">
                                {{timeAgo date}}
                            </span>
                        </div>
                        
                        <h4 class="note-card-title mb-2">
                            <a href="javascript:void(0)" class="quick-view-trigger" data-id="{{_id}}" data-title="{{title}}" data-notebook="{{notebook}}" data-date="{{GenerateDate date 'DD MMMM YYYY'}}" data-note="{{note}}">
                                {{title}}
                            </a>
                        </h4>

                        <div class="note-card-excerpt flex-grow-1 mb-3">
                            <p class="mb-0">{{truncate note 130}}</p>
                        </div>

                        <div class="note-card-footer d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                            <span class="font-size-12 text-muted">{{GenerateDate date 'DD MMM YYYY'}}</span>
                            <div class="action-btn-group">
                                <button type="button" class="action-btn quick-view-btn" title="Quick Read" data-id="{{_id}}" data-title="{{title}}" data-notebook="{{notebook}}" data-date="{{GenerateDate date 'DD MMMM YYYY'}}" data-note="{{note}}">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </button>
                                <a href="/SingleNote/{{_id}}" class="action-btn edit-btn" title="Edit Note">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                                <form action="/notes/{{_id}}?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this note?');">
                                    <button type="submit" class="action-btn delete-btn" title="Delete Note">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <!-- Empty Notes State -->
            <div class="empty-state-card text-center py-5">
                <div class="empty-icon-box mb-3">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                </div>
                <h3 class="empty-title mb-2">No notes created yet</h3>
                <p class="empty-subtitle mb-4">Start organizing your ideas, project specifications, or meeting notes.</p>
                <a href="/addNote" class="btn btn-primary d-inline-flex align-items-center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Create Your First Note
                </a>
            </div>
            {{/if}}
        </div>

        <!-- 2. TABLE VIEW CONTAINER (Hidden by default or toggled) -->
        <div id="notesTableContainer" class="d-none">
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table tbl-server-info" id="myTable">
                            <thead>
                                <tr>
                                    <th scope="col" style="min-width: 250px;">Title</th>
                                    <th scope="col">Notebook</th>
                                    <th scope="col">Created Date</th>
                                    <th scope="col" class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each fetched_notes}}
                                <tr>
                                    <td>
                                        <a href="/SingleNote/{{_id}}" class="hover-underline font-weight-700">
                                            {{title}}
                                        </a>
                                        <div class="text-muted font-size-12 mt-1">{{truncate note 70}}</div>
                                    </td>
                                    <td>
                                        <span class="notebook-pill">{{notebook}}</span>
                                    </td>
                                    <td>
                                        <div class="font-size-13 font-weight-600">{{GenerateDate date 'DD MMMM YYYY'}}</div>
                                        <div class="text-muted font-size-11">{{timeAgo date}}</div>
                                    </td>
                                    <td class="text-right">
                                        <div class="action-btn-group justify-content-end">
                                            <button type="button" class="action-btn quick-view-btn" title="Quick Read" data-id="{{_id}}" data-title="{{title}}" data-notebook="{{notebook}}" data-date="{{GenerateDate date 'DD MMMM YYYY'}}" data-note="{{note}}">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                            </button>
                                            <a href="/SingleNote/{{_id}}" class="action-btn edit-btn" title="Edit Note">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                            </a>
                                            <form action="/notes/{{_id}}?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this note?');">
                                                <button type="submit" class="action-btn delete-btn" title="Delete Note">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- No Filter Results State (Hidden by default) -->
        <div id="noResultsState" class="empty-state-card text-center py-5 d-none">
            <div class="empty-icon-box mb-3">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </div>
            <h3 class="empty-title mb-1">No matching notes</h3>
            <p class="empty-subtitle mb-3">Try modifying your search keywords or notebook filter.</p>
            <button type="button" id="resetFilterBtn" class="btn btn-secondary btn-sm">Reset Filters</button>
        </div>
    </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" role="dialog" aria-labelledby="quickViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content note-modal-content">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="notebook-pill" id="modalNotebookPill">Notebook</span>
                    <span class="font-size-12 text-muted" id="modalDateBadge">Date</span>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body py-4">
                <h3 class="modal-note-title mb-4" id="modalNoteTitle">Note Title</h3>
                <div class="modal-note-body" id="modalNoteBody">
                    <!-- Rendered HTML note content -->
                </div>
            </div>
            <div class="modal-footer border-top d-flex align-items-center justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm" id="modalCopyBtn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    <span>Copy Text</span>
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
                    <a href="#" class="btn btn-primary btn-sm" id="modalEditLink">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        Edit Note
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>