<div class="content-page">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap">
                        <div>
                            <h3 class="custom-heading mb-1">Your Notebooks</h3>
                            <p class="text-muted mb-0 font-size-14">Categorize your thoughts, projects, and work collections.</p>
                        </div>
                        <button type="button" class="btn btn-primary d-inline-flex align-items-center mt-2 mt-sm-0" data-toggle="modal" data-target="#exampleModal">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            Create Notebook
                        </button>
                    </div>

                    <!-- Create Notebook Modal -->
                    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="createNotebookLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="createNotebookLabel">Create New Notebook</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <form action="/addNotebook" method="POST">
                                    <div class="modal-body py-4">
                                        <div class="form-group mb-0">
                                            <label class="font-weight-700 mb-2">Notebook Name</label>
                                            <input type="text" name="notebook" class="form-control" placeholder="e.g. Work, Ideas, Architecture" required autocomplete="off">
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Save Notebook</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table tbl-server-info" id="myNotebookTable">
                            <thead>
                                <tr>
                                    <th scope="col">Notebook Name</th>
                                    <th scope="col">Created Date</th>
                                    <th scope="col" class="text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each fetched_notebooks}}
                                <tr>
                                    <td>
                                        <a href="/notebooks/{{name}}" class="hover-underline d-inline-flex align-items-center">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-muted"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                            {{name}}
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-muted">{{GenerateDate date 'DD MMMM YYYY'}}</span>
                                    </td>
                                    <td class="text-right">
                                        <div class="action-btn-group justify-content-end">
                                            <button value="{{_id}}" class="action-btn edit-btn edit-button" data-toggle="modal" data-target="#edit-note1" title="Edit Notebook">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                            </button>
                                            <form action="/notebooks/delete/{{_id}}?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this notebook?');">
                                                <button type="submit" class="action-btn delete-btn" title="Delete Notebook">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>

                    <!-- Edit Notebook Modal -->
                    <div class="modal fade" id="edit-note1" tabindex="-1" role="dialog" aria-labelledby="editNotebookLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="editNotebookLabel">Edit Notebook</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <form action="/editNotebook?_method=PUT" method="POST">
                                    <div class="modal-body py-4">
                                        <div class="form-group mb-0">
                                            <label class="font-weight-700 mb-2">Notebook Name</label>
                                            <input type="text" name="editInput" class="form-control editInput" required autocomplete="off">
                                            <input type="hidden" name="editInputId" class="editInputId">
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>