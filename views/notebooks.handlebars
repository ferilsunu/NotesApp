<div class="content-page">
    <div class="container-fluid">
        <!-- Flash Alerts -->
        {{#if success_message}}
        <div class="alert alert-custom alert-success d-flex align-items-center mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-3 flex-shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <div>{{success_message}}</div>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        {{/if}}

        {{#if error}}
        <div class="alert alert-custom alert-danger d-flex align-items-center mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-3 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <div>{{error}}</div>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        {{/if}}

        <!-- Hero Header -->
        <div class="hero-header-card mb-4">
            <div class="row align-items-center">
                <div class="col-lg-7 col-12 mb-3 mb-lg-0">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge-status-pill">
                            <span class="status-dot"></span>
                            Collections
                        </span>
                        <span class="text-muted font-size-13 ml-3">Organized Workspace</span>
                    </div>
                    <h2 class="hero-title mb-1">Your Notebooks</h2>
                    <p class="hero-subtitle mb-0">Group related notes into structured notebooks for projects, work, and personal ideas.</p>
                </div>
                <div class="col-lg-5 col-12 text-lg-right d-flex align-items-center justify-content-lg-end gap-3 flex-wrap">
                    <div class="stat-pill">
                        <span class="stat-pill-count">{{totalNotebooks}}</span>
                        <span class="stat-pill-label">Notebooks</span>
                    </div>
                    <div class="stat-pill">
                        <span class="stat-pill-count">{{totalNotes}}</span>
                        <span class="stat-pill-label">Total Notes</span>
                    </div>
                    <button type="button" class="btn btn-primary d-inline-flex align-items-center shadow-sm" data-toggle="modal" data-target="#createNotebookModal">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>New Notebook</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 1. NOTEBOOK CARDS GRID -->
        {{#if fetched_notebooks.length}}
        <div class="row mb-4" id="notebooksGrid">
            {{#each fetched_notebooks}}
            <div class="col-xl-4 col-lg-6 col-md-6 col-12 mb-4">
                <div class="notebook-card h-100 d-flex flex-column">
                    <div class="notebook-card-top d-flex align-items-start justify-content-between mb-3">
                        <div class="notebook-folder-icon">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </div>
                        <span class="notebook-counter-badge">
                            {{noteCount}} {{#if (eq noteCount 1)}}Note{{else}}Notes{{/if}}
                        </span>
                    </div>

                    <h4 class="notebook-card-name mb-1">
                        <a href="/notebooks/{{name}}" class="hover-underline">
                            {{name}}
                        </a>
                    </h4>
                    <p class="text-muted font-size-12 mb-4">Created on {{GenerateDate date 'DD MMMM YYYY'}}</p>

                    <div class="notebook-card-actions d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                        <a href="/notebooks/{{name}}" class="btn btn-outline-dark btn-sm d-inline-flex align-items-center">
                            <span>Open Notes</span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="ml-1"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </a>
                        <div class="action-btn-group">
                            <button value="{{_id}}" class="action-btn edit-btn edit-button" data-toggle="modal" data-target="#editNotebookModal" title="Rename Notebook">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </button>
                            <form action="/notebooks/delete/{{_id}}?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Deleting this notebook will also delete all notes inside it. Are you sure?');">
                                <button type="submit" class="action-btn delete-btn" title="Delete Notebook">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <!-- Empty Notebooks State -->
        <div class="empty-state-card text-center py-5">
            <div class="empty-icon-box mb-3">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <h3 class="empty-title mb-2">No notebooks created yet</h3>
            <p class="empty-subtitle mb-4">Create your first notebook to organize your notes by topic, project, or category.</p>
            <button type="button" class="btn btn-primary d-inline-flex align-items-center" data-toggle="modal" data-target="#createNotebookModal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Create First Notebook
            </button>
        </div>
        {{/if}}

        <!-- 2. TABLE VIEW SECTION (Collapsible or Detailed View) -->
        {{#if fetched_notebooks.length}}
        <div class="card mt-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="mb-0 font-weight-700">Detailed Notebook Registry</h5>
                    <span class="text-muted font-size-13">{{totalNotebooks}} Total</span>
                </div>
                <div class="table-responsive">
                    <table class="table tbl-server-info" id="myNotebookTable">
                        <thead>
                            <tr>
                                <th scope="col">Notebook Name</th>
                                <th scope="col">Notes Stored</th>
                                <th scope="col">Created Date</th>
                                <th scope="col" class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each fetched_notebooks}}
                            <tr>
                                <td>
                                    <a href="/notebooks/{{name}}" class="hover-underline font-weight-700 d-inline-flex align-items-center">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2 text-muted"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                        {{name}}
                                    </a>
                                </td>
                                <td>
                                    <span class="notebook-counter-badge">{{noteCount}}</span>
                                </td>
                                <td>
                                    <span class="text-muted font-size-13">{{GenerateDate date 'DD MMMM YYYY'}}</span>
                                </td>
                                <td class="text-right">
                                    <div class="action-btn-group justify-content-end">
                                        <a href="/notebooks/{{name}}" class="action-btn" title="View Notes">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                        </a>
                                        <button value="{{_id}}" class="action-btn edit-btn edit-button" data-toggle="modal" data-target="#editNotebookModal" title="Rename Notebook">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>
                                        <form action="/notebooks/delete/{{_id}}?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Deleting this notebook will also delete all notes inside it. Are you sure?');">
                                            <button type="submit" class="action-btn delete-btn" title="Delete Notebook">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {{/if}}
    </div>
</div>

<!-- Create Notebook Modal -->
<div class="modal fade" id="createNotebookModal" tabindex="-1" role="dialog" aria-labelledby="createNotebookLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center">
                    <div class="modal-header-icon mr-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    </div>
                    <h5 class="modal-title font-weight-700" id="createNotebookLabel">Create New Notebook</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form action="/addNotebook" method="POST">
                <div class="modal-body py-4">
                    <div class="form-group mb-0">
                        <label class="font-weight-700 mb-2 font-size-13 text-secondary">Notebook Name</label>
                        <input type="text" name="notebook" class="form-control" placeholder="e.g. Work Projects, Architecture, Reading" required autocomplete="off" autofocus>
                        <small class="form-text text-muted mt-2">Choose a concise name to categorize your notes effectively.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Create Notebook</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit / Rename Notebook Modal -->
<div class="modal fade" id="editNotebookModal" tabindex="-1" role="dialog" aria-labelledby="editNotebookLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center">
                    <div class="modal-header-icon mr-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </div>
                    <h5 class="modal-title font-weight-700" id="editNotebookLabel">Rename Notebook</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form action="/editNotebook?_method=PUT" method="POST">
                <div class="modal-body py-4">
                    <div class="form-group mb-0">
                        <label class="font-weight-700 mb-2 font-size-13 text-secondary">New Notebook Name</label>
                        <input type="text" name="editInput" class="form-control editInput" required autocomplete="off">
                        <input type="hidden" name="editInputId" class="editInputId">
                        <small class="form-text text-muted mt-2">All notes linked to this notebook will update automatically.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Update Name</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>