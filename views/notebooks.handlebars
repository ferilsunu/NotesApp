<main class="main-workspace">
    <!-- Top Workspace App Bar -->
    <header class="workspace-topbar">
        <div class="topbar-left d-flex align-items-center">
            <button type="button" class="btn-sidebar-toggle mr-2.5" id="btnSidebarToggle" title="Toggle Sidebar (Ctrl+\)">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
            </button>
            <h1 class="topbar-title">Notebooks</h1>
            <span class="topbar-count-badge">{{totalNotebooks}}</span>
        </div>

        <div class="topbar-right ml-auto">
            <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center" data-toggle="modal" data-target="#createNotebookModal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>New Notebook</span>
            </button>
        </div>
    </header>

    <div class="workspace-body">
        <!-- Flash Alerts -->
        {{#if success_message}}
        <div class="alert alert-custom alert-success d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2 flex-shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <div>{{success_message}}</div>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        {{/if}}

        {{#if error}}
        <div class="alert alert-custom alert-danger d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <div>{{error}}</div>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        {{/if}}

        {{#if fetched_notebooks.length}}
        <div class="notebooks-grid mb-4">
            {{#each fetched_notebooks}}
            <div class="notebook-box">
                <div class="notebook-box-top">
                    <div class="folder-badge-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <span class="notebook-count-pill">{{noteCount}} {{#if (eq noteCount 1)}}Note{{else}}Notes{{/if}}</span>
                </div>

                <h3 class="notebook-box-title">
                    <a href="/notebooks/{{name}}">{{name}}</a>
                </h3>
                <div class="notebook-box-date">Created on {{GenerateDate date 'DD MMMM YYYY'}}</div>

                <div class="notebook-box-footer">
                    <a href="/notebooks/{{name}}" class="btn btn-outline-dark btn-sm d-inline-flex align-items-center">
                        <span>View Notes</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="ml-1"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                    <div class="d-flex align-items-center gap-1">
                        <button value="{{_id}}" class="icon-action-btn edit-btn edit-button" data-toggle="modal" data-target="#editNotebookModal" title="Rename Notebook">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        </button>
                        <form action="/notebooks/delete/{{_id}}?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Deleting this notebook will also delete all notes inside it. Are you sure?');">
                            <button type="submit" class="icon-action-btn delete-btn" title="Delete Notebook">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <!-- Empty Notebook State -->
        <div class="clean-empty-state">
            <div class="empty-icon-circle">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <h3 class="empty-state-title">No notebooks yet</h3>
            <p class="empty-state-desc">Create notebooks to organize your notes by projects, clients, or topics.</p>
            <button type="button" class="btn btn-primary d-inline-flex align-items-center" data-toggle="modal" data-target="#createNotebookModal">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>Create Notebook</span>
            </button>
        </div>
        {{/if}}
    </div>
</main>

<!-- Create Notebook Modal -->
<div class="modal fade" id="createNotebookModal" tabindex="-1" role="dialog" aria-labelledby="createNotebookLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center">
                    <div class="modal-header-icon mr-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    </div>
                    <h5 class="modal-title font-weight-700" id="createNotebookLabel">Create New Notebook</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form action="/addNotebook" method="POST">
                <div class="modal-body py-4">
                    <div class="form-group mb-0">
                        <label class="font-weight-600 mb-2 font-size-13 text-secondary">Notebook Name</label>
                        <input type="text" name="notebook" class="form-control" placeholder="e.g. Work Projects, Architecture, Ideas" required autocomplete="off" autofocus>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm d-inline-flex align-items-center">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Create Notebook</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit / Rename Notebook Modal -->
<div class="modal fade" id="editNotebookModal" tabindex="-1" role="dialog" aria-labelledby="editNotebookLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center">
                    <div class="modal-header-icon mr-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </div>
                    <h5 class="modal-title font-weight-700" id="editNotebookLabel">Rename Notebook</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form action="/editNotebook?_method=PUT" method="POST">
                <div class="modal-body py-4">
                    <div class="form-group mb-0">
                        <label class="font-weight-600 mb-2 font-size-13 text-secondary">New Notebook Name</label>
                        <input type="text" name="editInput" class="form-control editInput" required autocomplete="off">
                        <input type="hidden" name="editInputId" class="editInputId">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm d-inline-flex align-items-center">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Update Name</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>