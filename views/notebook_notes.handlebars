<main class="main-workspace">
    <!-- Top Workspace App Bar -->
    <header class="workspace-topbar">
        <div class="topbar-left d-flex align-items-center">
            <button type="button" class="btn-sidebar-toggle mr-2" id="btnSidebarToggle" title="Toggle Sidebar (Ctrl+\)">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
            </button>
            <a href="/notebooks" class="topbar-back-link mr-2" title="Back to Notebooks">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </a>
            <h1 class="topbar-title">{{notebook.name}}</h1>
            <span class="topbar-count-badge" id="notesCountFeedback">{{fetched_notes.length}}</span>
        </div>

        <div class="topbar-center">
            <div class="topbar-search-wrap">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" id="noteSearchInput" class="topbar-search-input" placeholder="Search in {{notebook.name}}...">
                <button type="button" id="clearSearchBtn" class="topbar-clear-btn d-none" title="Clear search">&times;</button>
            </div>
        </div>

        <div class="topbar-right">
            <div class="view-toggle-wrap">
                <button type="button" class="view-toggle-btn active" id="btnGridView" title="Grid View">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                </button>
                <button type="button" class="view-toggle-btn" id="btnTableView" title="List View">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                </button>
            </div>

            <a href="/addNote" class="btn btn-primary btn-sm d-inline-flex align-items-center">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>New Note</span>
            </a>
        </div>
    </header>

    <div class="workspace-body">
        <!-- 1. GRID VIEW CONTAINER -->
        <div id="notesGridContainer">
            {{#if fetched_notes.length}}
            <div class="notes-grid" id="notesCardGrid">
                {{#each fetched_notes}}
                <div class="note-card-item" data-title="{{title}}" data-notebook="{{notebook}}" data-content="{{stripTags note}}">
                    <div class="note-box" data-href="/SingleNote/{{_id}}">
                        <div class="note-box-header">
                            <span class="category-chip">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                {{notebook}}
                            </span>
                            <span class="note-relative-time" title="{{GenerateDate date 'DD MMMM YYYY, hh:mm A'}}">
                                {{timeAgo date}}
                            </span>
                        </div>

                        <h3 class="note-box-title">
                            <a href="/SingleNote/{{_id}}" class="note-box-title-link">
                                {{title}}
                            </a>
                        </h3>

                        <div class="note-box-preview">
                            <p>{{truncate note 140}}</p>
                        </div>

                        <div class="note-box-footer">
                            <span class="note-date-text">{{GenerateDate date 'DD MMM YYYY'}}</span>
                            <div class="note-actions">
                                <a href="/SingleNote/{{_id}}" class="icon-action-btn edit-btn" title="Edit Note">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                                <form action="/notes/{{_id}}?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this note?');">
                                    <button type="submit" class="icon-action-btn delete-btn" title="Delete Note">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <!-- Empty Notes State -->
            <div class="clean-empty-state">
                <div class="empty-icon-circle">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                </div>
                <h3 class="empty-state-title">No notes in "{{notebook.name}}" yet</h3>
                <p class="empty-state-desc">Create your first note in this notebook.</p>
                <a href="/addNote" class="btn btn-primary d-inline-flex align-items-center">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Create Note</span>
                </a>
            </div>
            {{/if}}
        </div>

        <!-- 2. TABLE VIEW CONTAINER -->
        <div id="notesTableContainer" class="d-none">
            <div class="clean-table-card">
                <div class="table-responsive">
                    <table class="table clean-table" id="myTable">
                        <thead>
                            <tr>
                                <th scope="col" style="min-width: 260px;">Note Title</th>
                                <th scope="col">Notebook</th>
                                <th scope="col">Date Created</th>
                                <th scope="col" class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each fetched_notes}}
                            <tr class="clickable-row" data-href="/SingleNote/{{_id}}">
                                <td>
                                    <a href="/SingleNote/{{_id}}" class="table-note-title">
                                        {{title}}
                                    </a>
                                    <div class="table-note-sub">{{truncate note 65}}</div>
                                </td>
                                <td>
                                    <span class="category-chip">{{notebook}}</span>
                                </td>
                                <td>
                                    <div class="font-size-13 font-weight-600 text-dark">{{GenerateDate date 'DD MMMM YYYY'}}</div>
                                    <div class="text-muted font-size-11">{{timeAgo date}}</div>
                                </td>
                                <td class="text-right">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a href="/SingleNote/{{_id}}" class="icon-action-btn edit-btn" title="Edit Note">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </a>
                                        <form action="/notes/{{_id}}?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this note?');">
                                            <button type="submit" class="icon-action-btn delete-btn" title="Delete Note">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- No Filter Results State -->
        <div id="noResultsState" class="clean-empty-state d-none">
            <div class="empty-icon-circle">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </div>
            <h3 class="empty-state-title">No matching notes found</h3>
            <p class="empty-state-desc">Try clearing the search query.</p>
            <button type="button" id="resetFilterBtn" class="btn btn-secondary btn-sm">Clear Search</button>
        </div>
    </div>
</main>