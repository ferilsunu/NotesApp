<main class="main-workspace">
    <form action="/editNote/{{fetched_single_note._id}}?_method=PUT" method="POST" id="noteEditorForm">
        <!-- Top Workspace App Bar -->
        <header class="workspace-topbar">
            <div class="topbar-left d-flex align-items-center">
                <a href="/" class="topbar-back-link mr-2" title="Back to Notes">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                </a>
                <h1 class="topbar-title text-truncate" style="max-width: 320px;">{{fetched_single_note.title}}</h1>
                <span class="topbar-count-badge ml-2 font-size-11">Editing</span>
            </div>

            <div class="topbar-right ml-auto d-flex align-items-center gap-2">
                <div class="live-counter-pill d-none d-md-flex align-items-center mr-2">
                    <span id="wordCountBadge">0 words</span>
                    <span class="counter-separator">•</span>
                    <span id="charCountBadge">0 chars</span>
                </div>
                <a href="/" class="btn btn-secondary btn-sm">Cancel</a>
                <button type="submit" class="btn btn-primary btn-sm d-inline-flex align-items-center">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                    <span>Save Changes</span>
                </button>
            </div>
        </header>

        <div class="workspace-body">
            <!-- Flash Alerts -->
            {{#if error}}
            <div class="alert alert-custom alert-danger d-flex align-items-center mb-4" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <div>{{error}}</div>
                <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            {{/if}}

            <div class="editor-surface">
                <div class="row">
                    <div class="col-lg-8 col-12 mb-3">
                        <label class="clean-field-label">Note Title</label>
                        <input type="text" class="form-control clean-title-field" name="title" value="{{fetched_single_note.title}}" placeholder="Note title..." required autocomplete="off">
                    </div>

                    <div class="col-lg-4 col-12 mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="clean-field-label mb-0">Notebook</label>
                            <a href="/notebooks" class="font-size-11 text-muted hover-underline" target="_blank">+ Manage</a>
                        </div>
                        <div class="clean-select-wrap">
                            <select name="notebook" id="slct" required>
                                {{#select fetched_single_note.notebook}}
                                    {{#each fetched_notebooks}}
                                    <option value="{{name}}">{{name}}</option>
                                    {{/each}}
                                {{/select}}
                            </select>
                        </div>
                    </div>

                    <div class="col-12 mt-2">
                        <label class="clean-field-label">Content</label>
                        <div class="editor-area-wrap">
                            <textarea id="mytextarea" class="form-control" name="note" rows="22">{{fetched_single_note.note}}</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</main>
