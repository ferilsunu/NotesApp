<div class="content-page">
    <div class="container-fluid">
        <!-- Flash Alerts -->
        {{#if error}}
        <div class="alert alert-custom alert-danger d-flex align-items-center mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-3 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <div>{{error}}</div>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        {{/if}}

        <form action="/addNote" method="POST" id="noteEditorForm">
            <!-- Header Action Card -->
            <div class="editor-header-card mb-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center">
                        <a href="/" class="btn-icon-back mr-3" title="Back to Notes">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                        </a>
                        <div>
                            <div class="d-flex align-items-center mb-1">
                                <span class="badge-status-pill">
                                    <span class="status-dot"></span>
                                    New Note
                                </span>
                            </div>
                            <h2 class="hero-title mb-0">Create New Note</h2>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <div class="editor-meta-stats d-none d-md-flex align-items-center mr-3">
                            <span class="meta-stat-pill" id="wordCountBadge">0 words</span>
                            <span class="meta-stat-pill ml-2" id="charCountBadge">0 chars</span>
                        </div>
                        <a href="/" class="btn btn-secondary">Discard</a>
                        <button type="submit" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                            <span>Save Note</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Main Editor Card -->
            <div class="card editor-main-card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-8 col-12 mb-3">
                            <label class="form-section-label">Note Title</label>
                            <input type="text" class="form-control editor-title-input" name="title" placeholder="Give your note a title..." required autofocus autocomplete="off">
                        </div>

                        <div class="col-lg-4 col-12 mb-3">
                            <div class="d-flex align-items-center justify-content-between">
                                <label class="form-section-label">Notebook Collection</label>
                                <a href="/notebooks" class="font-size-12 text-muted hover-underline" target="_blank">+ Manage</a>
                            </div>
                            <div class="select-wrapper">
                                <select name="notebook" id="slct" required>
                                    {{#if fetched_notebooks.length}}
                                        {{#each fetched_notebooks}}
                                        <option value="{{name}}">{{name}}</option>
                                        {{/each}}
                                    {{else}}
                                        <option value="General">General</option>
                                    {{/if}}
                                </select>
                            </div>
                        </div>

                        <div class="col-12 mt-2">
                            <label class="form-section-label">Note Content</label>
                            <div class="editor-textarea-wrapper">
                                <textarea id="mytextarea" class="form-control" name="note" rows="22" placeholder="Write your thoughts, documentation, code, or ideas here..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
