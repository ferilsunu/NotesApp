<div class="content-page">
    <div class="row">
        <div class="col-lg-12">                
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <h3 class="custom-heading mb-1">Create New Note</h3>
                            <p class="text-muted mb-0 font-size-14">Draft your ideas, markdown notes, or code snippets.</p>
                        </div>
                        <a href="/" class="btn btn-secondary d-inline-flex align-items-center">
                            Cancel
                        </a>
                    </div>

                    <form action="/addNote" method="POST">
                        <div class="row">
                            <div class="col-md-8 col-12">
                                <div class="form-group mb-3">
                                    <label class="font-weight-700">Note Title</label>
                                    <input type="text" class="form-control font-weight-600" name="title" placeholder="Enter note title..." required autocomplete="off">
                                </div>
                            </div>

                            <div class="col-md-4 col-12">
                                <div class="form-group mb-3">
                                    <label class="font-weight-700">Notebook</label>
                                    <div class="select-wrapper">
                                        <select name="notebook" id="slct" required>
                                            {{#each fetched_notebooks}}
                                            <option value="{{name}}">{{name}}</option>
                                            {{/each}}
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group mb-4">
                                    <label class="font-weight-700">Content</label>
                                    <textarea id="mytextarea" class="form-control" name="note" rows="18" placeholder="Type your note content here..."></textarea>
                                </div>
                            </div>

                            <div class="col-12 d-flex align-items-center">
                                <button type="submit" class="btn btn-primary d-inline-flex align-items-center mr-3">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                                    Save Note
                                </button>
                                <a href="/" class="btn btn-secondary">Cancel</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
