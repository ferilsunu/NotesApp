<main class="main-workspace notion-mode">
    <form action="/addNote" method="POST" id="noteEditorForm" data-mode="add">
        <!-- Minimal Notion-Style Top Bar -->
        <header class="workspace-topbar notion-topbar">
            <div class="topbar-left d-flex align-items-center">
                <button type="button" class="btn-sidebar-toggle mr-2.5" id="btnSidebarToggle" title="Toggle Sidebar (Ctrl+\)">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                </button>
                <div class="notion-breadcrumb d-flex align-items-center">
                    <a href="/" class="breadcrumb-home" title="All Notes">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                    </a>
                    <span class="breadcrumb-slash">/</span>
                    <div class="notion-notebook-dropdown dropdown">
                        <button type="button" class="notion-notebook-pill-btn" id="notebookDropdownMenuBtn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Change Notebook">
                            <span class="notebook-pill-icon">📁</span>
                            <span class="notebook-pill-label" id="selectedNotebookLabel">{{#if fetched_notebooks.[0].name}}{{fetched_notebooks.[0].name}}{{else}}General{{/if}}</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="notebook-pill-chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </button>
                        <input type="hidden" name="notebook" id="slct" value="{{#if fetched_notebooks.[0].name}}{{fetched_notebooks.[0].name}}{{else}}General{{/if}}">
                        <div class="dropdown-menu custom-dropdown-popover notion-notebook-menu" aria-labelledby="notebookDropdownMenuBtn">
                            <div class="dropdown-popover-header">
                                <span>SELECT NOTEBOOK</span>
                            </div>
                            <div class="dropdown-popover-list">
                                {{#if fetched_notebooks.length}}
                                    {{#each fetched_notebooks}}
                                    <button type="button" class="dropdown-popover-item notebook-select-option {{#if @first}}active{{/if}}" data-value="{{name}}">
                                        <span class="item-icon">📁</span>
                                        <span class="item-text">{{name}}</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="item-check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    </button>
                                    {{/each}}
                                {{else}}
                                    <button type="button" class="dropdown-popover-item notebook-select-option active" data-value="General">
                                        <span class="item-icon">📁</span>
                                        <span class="item-text">General</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="item-check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    </button>
                                {{/if}}
                            </div>
                            <div class="dropdown-divider my-1"></div>
                            <a href="/notebooks" class="dropdown-popover-action" target="_blank">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1.5"><path d="M12 5v14M5 12h14"/></svg>
                                <span>Manage Notebooks</span>
                            </a>
                        </div>
                    </div>
                    <a href="/notebooks" class="notebook-manage-pill ml-2" target="_blank" title="Manage Notebooks">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        <span>Manage</span>
                    </a>
                </div>
            </div>

            <div class="topbar-right ml-auto d-flex align-items-center gap-2">
                <div class="notion-save-status" id="autoSaveStatus" title="Changes are saved automatically">
                    <span class="save-status-icon">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="icon-saved"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span class="spinner-border spinner-border-sm icon-saving d-none" role="status"></span>
                    </span>
                    <span class="save-status-text">Saved</span>
                </div>
                <div class="live-counter-pill d-none d-md-flex align-items-center">
                    <span id="wordCountBadge">0 words</span>
                    <span class="counter-separator">•</span>
                    <span id="charCountBadge">0 chars</span>
                </div>
                <button type="button" class="btn-icon-subtle active" id="btnToggleToolbar" title="Toggle Formatting Toolbar (Ctrl+Shift+F)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                </button>
                <button type="button" class="btn-icon-subtle" id="btnToggleFullWidth" title="Toggle Full Width Canvas">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
                </button>
            </div>
        </header>

        <!-- Notion Borderless Document Canvas -->
        <div class="notion-viewport">
            <div class="notion-doc-surface" id="notionDocSurface">
                <!-- Flash Alerts -->
                {{#if error}}
                <div class="alert alert-custom alert-danger d-flex align-items-center mb-4" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-2 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <div>{{error}}</div>
                    <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                {{/if}}

                <!-- Borderless Title -->
                <div class="notion-title-wrap">
                    <textarea class="notion-title-input" name="title" rows="1" placeholder="Untitled" required autofocus autocomplete="off"></textarea>
                </div>

                <!-- Sleek Floating / Sticky Notion Toolbar -->
                <div class="notion-rich-editor" id="customRichEditor">
                    <div class="notion-toolbar" id="notionToolbar">
                        <div class="toolbar-group">
                            <select class="toolbar-select" id="formatBlockSelect" title="Text Style">
                                <option value="p">Paragraph</option>
                                <option value="h1">Heading 1</option>
                                <option value="h2">Heading 2</option>
                                <option value="h3">Heading 3</option>
                                <option value="blockquote">Quote</option>
                                <option value="pre">Code Block</option>
                            </select>
                        </div>

                        <div class="toolbar-divider"></div>

                        <div class="toolbar-group">
                            <button type="button" class="toolbar-btn" data-cmd="bold" title="Bold (Ctrl+B)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="italic" title="Italic (Ctrl+I)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="underline" title="Underline (Ctrl+U)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"></path><line x1="4" y1="21" x2="20" y2="21"></line></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="strikeThrough" title="Strikethrough">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="17" y1="5" x2="9" y2="19"></line><line x1="4" y1="12" x2="20" y2="12"></line></svg>
                            </button>
                        </div>

                        <div class="toolbar-divider"></div>

                        <div class="toolbar-group">
                            <button type="button" class="toolbar-btn" data-cmd="justifyLeft" title="Align Left">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="17" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="17" y1="18" x2="3" y2="18"></line></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="justifyCenter" title="Align Center">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="10" x2="6" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="18" y1="18" x2="6" y2="18"></line></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="justifyRight" title="Align Right">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="21" y1="10" x2="7" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="7" y2="18"></line></svg>
                            </button>
                        </div>

                        <div class="toolbar-divider"></div>

                        <div class="toolbar-group">
                            <button type="button" class="toolbar-btn" data-cmd="insertUnorderedList" title="Bulleted List">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="insertOrderedList" title="Numbered List">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg>
                            </button>
                        </div>

                        <div class="toolbar-divider"></div>

                        <div class="toolbar-group">
                            <button type="button" class="toolbar-btn" id="btnInsertLink" title="Insert Link">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                            </button>
                            <button type="button" class="toolbar-btn" id="btnInsertCode" title="Inline Code">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="insertHorizontalRule" title="Divider">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="removeFormat" title="Clear Formatting">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>

                        <div class="toolbar-divider ml-auto"></div>

                        <div class="toolbar-group">
                            <button type="button" class="toolbar-btn" data-cmd="undo" title="Undo (Ctrl+Z)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path></svg>
                            </button>
                            <button type="button" class="toolbar-btn" data-cmd="redo" title="Redo (Ctrl+Y)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 7v6h-6"></path><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"></path></svg>
                            </button>
                        </div>

                        <div class="toolbar-divider"></div>

                        <div class="toolbar-group">
                            <button type="button" class="toolbar-btn" id="btnCloseToolbar" title="Hide Toolbar">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Notion Borderless Canvas -->
                    <div class="notion-canvas" id="richEditorCanvas" contenteditable="true" spellcheck="true" data-placeholder="Press '/' for commands or start typing your note..."></div>
                    
                    <!-- Hidden Textarea for Form POST submission -->
                    <textarea name="note" id="hiddenNoteContent" class="d-none" required></textarea>
                </div>
            </div>
        </div>
    </form>
</main>
