<section class="auth-section">
    <div class="auth-container">
        {{#if custom_error}}
        <div class="alert alert-custom alert-danger mb-3" role="alert">
            <div class="font-weight-600">{{custom_error}}</div>
        </div>
        {{/if}}

        <div class="auth-card">
            <!-- Brand Mark Centered -->
            <div class="text-center mb-4">
                <div class="auth-brand-badge mx-auto mb-2">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                </div>
                <h4 class="auth-brand-title">NOTES APP</h4>
            </div>

            <div class="text-center mb-4">
                <h2 class="auth-heading">Create an Account</h2>
                <p class="auth-subheading">Get started with your free personal workspace.</p>
            </div>

            <form action="/register" method="POST" oninput='confirm_password.setCustomValidity(confirm_password.value != password.value ? "Passwords do not match." : "")'>
                <div class="form-group mb-3">
                    <label class="auth-form-label">Full Name</label>
                    <div class="auth-input-wrap">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="auth-input-icon"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <input class="form-control auth-input" name="name" type="text" placeholder="John Doe" required autocomplete="name" autofocus>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="auth-form-label">Email Address</label>
                    <div class="auth-input-wrap">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="auth-input-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        <input class="form-control auth-input" type="email" placeholder="name@example.com" name="email" required autocomplete="email">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 col-12">
                        <div class="form-group mb-3">
                            <label class="auth-form-label">Password</label>
                            <div class="auth-input-wrap">
                                <input class="form-control auth-input" name="password" id="regPassword" type="password" placeholder="••••••••" required autocomplete="new-password">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <div class="form-group mb-3">
                            <label class="auth-form-label">Confirm Password</label>
                            <div class="auth-input-wrap">
                                <input class="form-control auth-input" type="password" placeholder="••••••••" required name="confirm_password" autocomplete="new-password">
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block auth-submit-btn">Create Account</button>

                <div class="auth-footer-text text-center mt-4 pt-3 border-top">
                    <span>Already have an account?</span>
                    <a href="/login" class="auth-link font-weight-700 ml-1">Sign In</a>
                </div>
            </form>
        </div>
    </div>
</section>