<section class="login-content">
    <div class="container h-100">
        <div class="row justify-content-center align-items-center height-self-center">
            <div class="col-lg-5 col-md-7 col-sm-10 col-12">
                <div class="sign-user_card">
                    <div class="d-flex align-items-center mb-4">
                        <div class="app-brand-badge mr-3">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                            </svg>
                        </div>
                        <div>
                            <h4 class="app-brand-title mb-0">NOTES APP</h4>
                            <span class="app-brand-sub">FERIL SUNU</span>
                        </div>
                    </div>  

                    <h3 class="mb-1 font-weight-800">Create Account</h3>
                    <p class="text-muted mb-4 font-size-14">Get started with your free cloud workspace.</p>

                    <form action="/register" method="POST" oninput='confirm_password.setCustomValidity(confirm_password.value != password.value ? "Passwords do not match." : "")'>
                        <div class="form-group mb-3">
                            <label class="font-weight-700">Full Name</label>
                            <input class="form-control" name="name" type="text" placeholder="Feril Sunu" required autocomplete="name">
                        </div>

                        <div class="form-group mb-3">
                            <label class="font-weight-700">Email Address</label>
                            <input class="form-control" type="email" placeholder="name@example.com" name="email" required autocomplete="email">
                        </div>

                        <div class="row">
                            <div class="col-md-6 col-12">
                                <div class="form-group mb-3">
                                    <label class="font-weight-700">Password</label>
                                    <input class="form-control" name="password" type="password" placeholder="••••••••" required autocomplete="new-password">
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="form-group mb-3">
                                    <label class="font-weight-700">Confirm</label>
                                    <input class="form-control" type="password" placeholder="••••••••" required name="confirm_password" autocomplete="new-password">
                                </div>
                            </div>
                        </div>

                        {{#if custom_error}}
                        <div class="alert alert-danger py-2 mb-3 font-size-13 text-center" role="alert">
                            {{custom_error}}
                        </div>
                        {{/if}}

                        <button type="submit" class="btn btn-primary btn-block py-2">Create Account</button>

                        <div class="mt-4 pt-2 text-center border-top">
                            <p class="mb-0 text-muted font-size-14">
                                Already have an account? <a href="/login" class="font-weight-700 text-dark">Sign In</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>